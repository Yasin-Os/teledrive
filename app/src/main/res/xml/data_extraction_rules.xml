<?xml version="1.0" encoding="utf-8"?>
<!-- Data extraction rules (API 31+). Same exclusions as backup_rules.xml:
     the Room database (its key is device-bound in the Keystore) and the
     TDLib database (contains the Telegram session) must never be copied to
     a cloud backup or to another device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="secure_settings_v2.xml" />
        <exclude domain="sharedpref" path="fallback_settings.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs_key_keyset__.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs_value_keyset__.xml" />
        <exclude domain="file" path="tdlib/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="secure_settings_v2.xml" />
        <exclude domain="sharedpref" path="fallback_settings.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs_key_keyset__.xml" />
        <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs_value_keyset__.xml" />
        <exclude domain="file" path="tdlib/" />
    </device-transfer>
</data-extraction-rules>
