<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup rules (API 23-30; API 31+ uses data_extraction_rules.xml).
     The Room database and every file that can decrypt it must never leave
     the device in a cloud backup: the database key lives in the Android
     Keystore, which does not transfer, and the legacy plaintext database
     must never be uploaded at all. -->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="secure_settings_v2.xml" />
    <exclude domain="sharedpref" path="fallback_settings.xml" />
    <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs_key_keyset__.xml" />
    <exclude domain="sharedpref" path="__androidx_security_crypto_encrypted_prefs_value_keyset__.xml" />
    <exclude domain="file" path="tdlib/" />
</full-backup-content>
