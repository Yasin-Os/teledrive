<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. Vibrant Eye-Catching Sky-Cyan to Royal Sapphire Background -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="12"
                android:startY="10"
                android:endX="96"
                android:endY="98"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF00D2FF" />
                <item android:offset="0.45" android:color="#FF0078FF" />
                <item android:offset="1.0" android:color="#FF0038A8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 2. Subtle Top-Left Glass Highlight Glow -->
    <path android:pathData="M28,22m-38,0a38,38 0,1 1,76 0a38,38 0,1 1,-76 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="28"
                android:centerY="22"
                android:gradientRadius="38"
                android:type="radial">
                <item android:offset="0.0" android:color="#4DFFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 3. Back 3D Glass Cloud Layer (Gives Rich iCloud / OneDrive Depth) -->
    <path
        android:pathData="M42,64 L82,64 A13,13 0 0,0 82,38 A12,12 0 0,0 79.5,38.3 A17,17 0 0,0 47.5,34.5 A14.5,14.5 0 0,0 42,64 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="62"
                android:startY="24"
                android:endX="62"
                android:endY="64"
                android:type="linear">
                <item android:offset="0.0" android:color="#88FFFFFF" />
                <item android:offset="1.0" android:color="#33B3E5FC" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 4. Soft Drop Shadow Under Main Cloud -->
    <path
        android:pathData="M31,79 L77,79 A13.5,13.5 0 0,0 78.8,52.2 A15,15 0 0,0 65.2,39.8 A21,21 0 0,0 26.8,46.5 A16.5,16.5 0 0,0 31,79 Z"
        android:fillColor="#26001848" />

    <!-- 5. Main Large Sculpted White 3D Cloud (Perfect Circular Arcs) -->
    <path
        android:pathData="M31,75.5 L77,75.5 A13.5,13.5 0 0,0 78.8,48.7 A15,15 0 0,0 65.2,36.3 A21,21 0 0,0 26.8,43.0 A16.5,16.5 0 0,0 31,75.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54"
                android:startY="26"
                android:endX="54"
                android:endY="76"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFFFFF" />
                <item android:offset="0.7" android:color="#FFF5FBFF" />
                <item android:offset="1.0" android:color="#FFD6EEFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 6. 3D Inner Contour Fold on Cloud (OneDrive / iCloud Pro Style) -->
    <path
        android:pathData="M31,75.5 L62,75.5 C62,61 50,51 35.5,51 C24.5,51 16,58.5 16,66.5 C16,71.8 22.5,75.5 31,75.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="16"
                android:startY="51"
                android:endX="60"
                android:endY="75.5"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFFFFFF" />
                <item android:offset="1.0" android:color="#FFE1F3FF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
